# MCP workspace and transport
CHARACTER_STUDIO_WORKSPACE=.
CHARACTER_STUDIO_MCP_HOST=127.0.0.1
CHARACTER_STUDIO_MCP_PORT=8787
CHARACTER_STUDIO_MCP_PATH=/mcp

# Set a strong token before binding to a non-loopback host.
CHARACTER_STUDIO_MCP_AUTH_TOKEN=replace-with-a-long-random-token
CHARACTER_STUDIO_MCP_CORS_ORIGIN=

# Set both paths to enable native HTTPS. Keep certificate/key files outside git.
# CHARACTER_STUDIO_MCP_TLS_CERT=/absolute/path/to/fullchain.pem
# CHARACTER_STUDIO_MCP_TLS_KEY=/absolute/path/to/private-key.pem
